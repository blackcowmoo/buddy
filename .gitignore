# deps
node_modules/
.pnpm-store/

# build output
dist/
apps/web/dist/
bin/
apps/server/bin/
apps/web/coverage/
# frontend copied here only during the embed/Docker build
apps/server/internal/webassets/dist/

# models (downloaded separately, large)
models/*
!models/.gitkeep
*.bin
*.gguf
*.onnx
# ...except the one small (~500 KB) voice style vector committed so the app
# can pre-seed it into Cache Storage instead of depending on a HuggingFace
# fetch at TTS generation time — see kokoro.ts's seedVoiceCache().
!apps/web/public/tts-voices/*.bin

# env / local
.env
.env.local
*.local

# Claude session context — kept on disk locally, not committed
CLAUDE.md

# os / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# go
*.test
*.out
