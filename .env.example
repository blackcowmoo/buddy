# Copy to .env and adjust. All values are optional; sane defaults are baked in.

# server
BUDDY_ENV=dev                 # dev = reverse-proxy to Vite; prod = serve apps/web/dist
BUDDY_ADDR=:8080              # single entry point (page + /api + /ws)
BUDDY_WEB_DIST=apps/web/dist  # static dir served in prod
BUDDY_VITE_URL=http://localhost:5173  # dev proxy target

# Mounts the whole app under a path prefix instead of "/", e.g. for a
# PR-preview deployment that an external router sends /pr/14/* to. Leave
# empty (default) to mount at "/".
ROOT_PATH=

# STT: legacy per-track switch, used only when no server engine below is
# configured. mock | whisper  (mock works with zero setup)
BUDDY_FAST_STT=mock
BUDDY_SLOW_STT=mock
BUDDY_WHISPER_BIN=whisper-cli
BUDDY_WHISPER_FAST_MODEL=models/ggml-tiny.en.bin
BUDDY_WHISPER_SLOW_MODEL=models/ggml-large-v3.bin

# STT server engine: any OpenAI-compatible /v1/audio/transcriptions server —
# whisper.cpp's `server` example, parakeet.cpp, or similar. Takes priority over
# BUDDY_FAST_STT/BUDDY_SLOW_STT above when set; the same engine serves both the
# fast and refine track. Comma-separated "model@url" entries round-robin
# across them — a bare "url" with no "model@" prefix is fine too, it just
# omits the "model" field for that endpoint. A single env var per engine, not
# a *_URLS + *_MODEL(S) pair to keep in sync: a comma list is presumed to
# allow a different model behind each endpoint, so the model travels with its
# own URL. The first engine below with its *_URLS var set wins (whisper
# checked before parakeet) — see config.sttEngines. Adding a future engine is
# just a new row there, no other code changes.
#   whisper-server -m ggml-large-v3-turbo.bin --port 8082
WHISPER_SERVER_URLS=      # e.g. whisper-large-v3-turbo@http://localhost:8082/v1,whisper-large-v3-turbo@http://localhost:8083/v1
PARAKEET_SERVER_URLS=

# LLM: any OpenAI-compatible chat-completions server (llama.cpp's llama-server,
# vLLM, LM Studio, or the OpenAI API). Three independent purposes, matching the
# two-track pipeline (internal/pipeline.Pipeline) — every one a "model@url" env
# var (same format as the STT engines above; a bare "url" with no "model@"
# prefix works too), not a *_URL + *_MODEL pair to keep in sync separately.
# Comma-separate for the ensemble one, a single pair for the other two:
#   Chat:     FAST track's streamed reply. One endpoint.
#   Analysis: REFINE track's grammar-correction/compaction pass. Every
#             configured endpoint is called concurrently as an ensemble.
#   Judge:    synthesizes the analysis ensemble's outputs into the one result
#             the pipeline uses. One endpoint. Skipped automatically when
#             Analysis has a single candidate configured.
# If unreachable, chat degrades to an offline echo reply.
#   llama-server -m model.gguf --port 8081
BUDDY_LLM_API_KEY=              # optional bearer token, shared by all three (leave empty for local)

BUDDY_LLM_CHAT_URL=local-model@http://localhost:8081/v1      # llama.cpp ignores the model name; set a real one for OpenAI

BUDDY_LLM_ANALYSIS_URLS=local-model@http://localhost:8081/v1   # e.g. gemma-4-e4b@http://localhost:8084/v1,qwen3-6-35b-a3b@http://localhost:8085/v1

BUDDY_LLM_JUDGE_URL=local-model@http://localhost:8081/v1

# Learner's native language for correction explanations: ko | en | ja | zh | es
# The corrected English sentence always stays in English; only the "why it's
# wrong" explanation is written in this language.
BUDDY_FEEDBACK_LANG=ko

# Persistent per-user memory (internal/store, internal/session). A per-user
# profile (compact summary + recent verbatim turns) survives reconnects and
# restarts. MySQL (not SQLite) so the app can run as multiple replicas in
# Kubernetes. The database is shared with other services, so buddy creates its
# one table as buddy_profiles (buddy_ prefix) to avoid collisions. These use the
# plain MYSQL_* names (no BUDDY_ prefix) a shared secret store already injects.
# Bring your own instance, e.g.:
#   docker run -p 3306:3306 -e MYSQL_DATABASE=buddy -e MYSQL_USER=buddy \
#     -e MYSQL_PASSWORD=buddy -e MYSQL_ROOT_PASSWORD=root mysql:8.0
MYSQL_RW_HOSTNAME=localhost   # primary (read-write) host
MYSQL_RO_HOSTNAME=            # optional read replica; empty => read from primary
MYSQL_PORT=3306
MYSQL_USERNAME=buddy
MYSQL_PASSWORD=buddy
MYSQL_DATABASE=buddy
BUDDY_MAX_HISTORY_MESSAGES=20      # verbatim turns kept before folding into the summary

# Identity (internal/identity): who a Profile above belongs to.
#   cookie -> anonymous, zero setup: a random ID in a long-lived cookie. Not
#            real auth — fine for local dev, not for a real deployment.
#   oidc   -> verifies the Dex-issued JWT carried in the Authorization: Bearer
#            header directly against Dex's discovery/JWKS endpoint. A proxy
#            may still sit in front to turn a browser session cookie into
#            this header (browsers send cookies on the /ws handshake but
#            can't set custom headers there), but it's not a trust boundary:
#            the app verifies the token's signature itself, so a forged
#            header sent straight to the app is still rejected. The token's
#            "email" claim becomes the user ID; requests without a valid
#            token are refused (401).
#            The two claims actually trusted are "iss" (must match
#            BUDDY_OIDC_ISSUER_URL — also where the discovery doc + JWKS are
#            fetched from) and "aud" (must match BUDDY_OIDC_CLIENT_ID).
BUDDY_IDENTITY_MODE=cookie
BUDDY_OIDC_ISSUER_URL=https://dex.micalgenus.com  # Dex issuer (token "iss")
BUDDY_OIDC_CLIENT_ID=buddy-frontend               # expected audience (token "aud")

# Optional (oidc mode only): cache verification results in a Redis Cluster so
# the auth path stays fast/available even if Dex is slow or briefly down
# (internal/identity/cached_oidc.go). Empty REDIS_CLUSTER_HOST (default)
# means every check verifies the token directly, same as before this existed
# -- fine, since verification is already local once Dex's JWKS is cached.
# Redis is never a hard dependency: any Redis error just falls through to
# direct verification. REDIS_CLUSTER_HOST is a single seed node -- go-redis
# discovers the rest of the cluster's topology from it. No BUDDY_ prefix,
# same convention as MYSQL_* above, for a shared secret store to inject.
REDIS_CLUSTER_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible object storage, shared by two independent features that both
# archive WS utterance audio to the same endpoint/credentials:
#   - Temporary audio backup (internal/audiostore): each incoming utterance's
#     raw PCM streamed to the bucket as a disposable temp copy. Nothing lists
#     or plays it back.
#   - Voice recording archive (internal/recording): the same audio,
#     WAV-wrapped and gzip-compressed, archived with metadata in MySQL so it
#     can be replayed later from the "recordings" page in the hamburger menu.
#     Nothing consumes the audio yet -- pure storage for now.
# Both are disabled (zero-setup default) until S3_BUCKET is set; with it
# unset, the WS handler just skips saving and /api/recordings answers 503.
# Written for Ceph RGW/MinIO: S3_PATH_STYLE=true because they commonly need
# the bucket in the URL path rather than a virtual-host subdomain, and
# S3_STORAGE_CLASS lets you steer these onto a specific (e.g.
# cheaper/temporary) disk pool instead of the bucket's default. Static
# credentials (not the AWS default credential chain/IRSA), same convention
# as MYSQL_*/REDIS_* above -- a shared secret store hands these out directly.
S3_ENDPOINT=                  # e.g. https://ceph.example.com; empty disables both features
S3_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_STORAGE_CLASS=              # e.g. REDUCED_REDUNDANCY; empty uses the bucket default
