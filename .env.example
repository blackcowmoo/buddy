# Copy to .env and adjust. All values are optional; sane defaults are baked in.

# server
BUDDY_ENV=dev                 # dev = reverse-proxy to Vite; prod = serve apps/web/dist
BUDDY_ADDR=:8080              # single entry point (page + /api + /ws)
BUDDY_WEB_DIST=apps/web/dist  # static dir served in prod
BUDDY_VITE_URL=http://localhost:5173  # dev proxy target

# Mounts the whole app under a path prefix instead of "/", e.g. for a
# PR-preview deployment that an external router sends /pr/14/* to. Leave
# empty (default) to mount at "/".
ROOT_PATH=

# STT engine: mock | whisper  (mock works with zero setup)
BUDDY_FAST_STT=mock
BUDDY_SLOW_STT=mock
BUDDY_WHISPER_BIN=whisper-cli
BUDDY_WHISPER_FAST_MODEL=models/ggml-tiny.en.bin
BUDDY_WHISPER_SLOW_MODEL=models/ggml-large-v3.bin

# LLM: any OpenAI-compatible chat-completions server (llama.cpp's llama-server,
# vLLM, LM Studio, or the OpenAI API). If unreachable, the server degrades to an
# echo reply. BUDDY_LLM_BASE_URL points at the /v1 root.
#   llama-server -m model.gguf --port 8081
BUDDY_LLM_BASE_URL=http://localhost:8081/v1
BUDDY_LLM_API_KEY=              # optional bearer token (leave empty for local)
BUDDY_LLM_CHAT_MODEL=local-model      # llama.cpp ignores this; set a real name for OpenAI
BUDDY_LLM_CORRECT_MODEL=local-model

# Learner's native language for correction explanations: ko | en | ja | zh | es
# The corrected English sentence always stays in English; only the "why it's
# wrong" explanation is written in this language.
BUDDY_FEEDBACK_LANG=ko

# Persistent per-user memory (internal/store, internal/session). A per-user
# profile (compact summary + recent verbatim turns) survives reconnects and
# restarts. MySQL (not SQLite) so the app can run as multiple replicas in
# Kubernetes. The database is shared with other services, so buddy creates its
# one table as buddy_profiles (buddy_ prefix) to avoid collisions. These use the
# plain MYSQL_* names (no BUDDY_ prefix) a shared secret store already injects.
# Bring your own instance, e.g.:
#   docker run -p 3306:3306 -e MYSQL_DATABASE=buddy -e MYSQL_USER=buddy \
#     -e MYSQL_PASSWORD=buddy -e MYSQL_ROOT_PASSWORD=root mysql:8.0
MYSQL_RW_HOSTNAME=localhost   # primary (read-write) host
MYSQL_RO_HOSTNAME=            # optional read replica; empty => read from primary
MYSQL_PORT=3306
MYSQL_USERNAME=buddy
MYSQL_PASSWORD=buddy
MYSQL_DATABASE=buddy
BUDDY_MAX_HISTORY_MESSAGES=20      # verbatim turns kept before folding into the summary

# Identity (internal/identity): who a Profile above belongs to.
#   cookie -> anonymous, zero setup: a random ID in a long-lived cookie. Not
#            real auth — fine for local dev, not for a real deployment.
#   oidc   -> verifies the Dex-issued JWT carried in the Authorization: Bearer
#            header directly against Dex's discovery/JWKS endpoint. A proxy
#            may still sit in front to turn a browser session cookie into
#            this header (browsers send cookies on the /ws handshake but
#            can't set custom headers there), but it's not a trust boundary:
#            the app verifies the token's signature itself, so a forged
#            header sent straight to the app is still rejected. The token's
#            "email" claim becomes the user ID; requests without a valid
#            token are refused (401).
#            The two claims actually trusted are "iss" (must match
#            BUDDY_OIDC_ISSUER_URL — also where the discovery doc + JWKS are
#            fetched from) and "aud" (must match BUDDY_OIDC_CLIENT_ID).
BUDDY_IDENTITY_MODE=cookie
BUDDY_OIDC_ISSUER_URL=https://dex.micalgenus.com  # Dex issuer (token "iss")
BUDDY_OIDC_CLIENT_ID=buddy-frontend               # expected audience (token "aud")

# Optional (oidc mode only): cache verification results in a Redis Cluster so
# the auth path stays fast/available even if Dex is slow or briefly down
# (internal/identity/cached_oidc.go). Empty REDIS_CLUSTER_HOST (default)
# means every check verifies the token directly, same as before this existed
# -- fine, since verification is already local once Dex's JWKS is cached.
# Redis is never a hard dependency: any Redis error just falls through to
# direct verification. REDIS_CLUSTER_HOST is a single seed node -- go-redis
# discovers the rest of the cluster's topology from it. No BUDDY_ prefix,
# same convention as MYSQL_* above, for a shared secret store to inject.
REDIS_CLUSTER_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
